# =============================================================================
# Title: Common - Short Term Tracker
#
# Description: This is a version of SiamRPN++ implemented in pytorch with the
# siammask library. Uses model: pysot_fish_siamrpn.pt.
# =============================================================================

process short_term_tracker
  :: track_objects
  :track_objects:type                          siammask

  block track_objects:siammask
    relativepath config_file =                 models/pysot_fish_siamrpn.yaml
    relativepath model_file =                  models/pysot_fish_siamrpn.pth
    :threshold                                 0.90
  endblock

# -- end of file --
