# =============================================================================
# Title: GFIT Stereo Measurement (Single Camera Detection, Core)
#
# Description: Stereo measurement pipeline that detects/tracks on the LEFT
# camera only. SAM2 segmentation and head/tail keypoint identification are
# applied to left-camera detections. The tracked result is fed to the left
# input of the core measurement process along with both stereo images. The
# measurement process computes a Fast-Foundation-Stereo disparity map to find
# corresponding right-camera keypoints and triangulates for 3D measurements.
# Uses model: fast_foundation_stereo_l.onnx.
#
# Requires Calibration: True
# =============================================================================

# ============================= GLOBAL PROPERTIES =============================

config _pipeline:_edge
  :capacity                                    30

config _scheduler
  :type                                        pythread_per_process

# ============================= INPUT FRAME LISTS =============================

include common_stereo_input_with_downsampler.pipe

# ================================= DETECTOR ==================================
include common_gfit_detector_v3.pipe

connect from downsampler.output_1
        to   detector_rgb_input.image
connect from downsampler.output_1
        to   detector_grey.image

# ================================ CLASSIFIER =================================

include common_gfit_classifier_groups_v3.pipe

connect from downsampler.output_1
        to   classifier_groups_all.image
connect from detector_fused.detected_object_set
        to   classifier_groups_all.detected_object_set

# =============================== KP ASSIGNMENT ===============================

process add_segmentations
  :: refine_detections
  :refiner:type                                ocv_windowed

  block refiner:ocv_windowed
    :mode                                      adaptive
    :chip_adaptive_thresh                      25000000
    :chip_width                                2000
    :chip_height                               2000
    :chip_step_width                           1000
    :chip_step_height                          1000

    :refiner:type                              sam2
    :refiner:sam2:cfg                          configs/sam2.1/sam2.1_hiera_b+.yaml
    :refiner:sam2:overwrite_existing           false
    relativepath refiner:sam2:checkpoint =     models/sam2_hbp.pt
  endblock

process add_head_tail
  :: refine_detections
  :refiner:type                                add_keypoints_from_mask

  block refiner:add_keypoints_from_mask
    :method                                    hull_extremes
    :clip_to_mask                              true
  endblock

connect from downsampler.output_1
        to   add_segmentations.image
connect from classifier_groups_output.detected_object_set
        to   add_segmentations.detected_object_set
connect from downsampler.output_1
        to   add_head_tail.image
connect from add_segmentations.detected_object_set
        to   add_head_tail.detected_object_set

# =============================== CORE TRACKER ================================

include common_gfit_tracker_v3.pipe

connect from downsampler.output_1
        to   tracker.image
connect from downsampler.timestamp
        to   tracker.timestamp
connect from add_head_tail.detected_object_set
        to   tracker.detected_object_set

# ============================= CORE MEASUREMENT ==============================

process measurer
  :: compute_measurements
  relativepath calibration_file =              models/gfit_example_cal.json
  :min_track_states                            6
  :matching_methods                            input_pairs_only,compute_disparity
  :record_head_tail_locations                  false    # DIVE_PARAM["Record Head/Tail 3D Locations", bool]

  stereo_disparity:type                        = fast_foundation_stereo_onnx

  block stereo_disparity:fast_foundation_stereo_onnx
    relativepath model_path                    = models/fast_foundation_stereo_l.onnx
    relativepath config_path                   = models/fast_foundation_stereo_l.yaml
    backend                                    = auto
    device                                     = auto
    output_mode                                = disparity
    remove_invisible                           = true
  endblock

  # The baseline has a large vertical component, so keep every source pixel
  # in the rectified frame rather than cropping to the valid region.
  :rectification_alpha                         -1.0

  # Right keypoints come from a robust fit of disparity along the whole
  # head-tail segment, since the endpoints sit on the silhouette edge.
  :refine_disparity_segment                    true
  :refine_keypoints_disparity_percentile       0.9
  :disparity_segment_samples                   11
  :disparity_segment_max_outliers              3
  :disparity_segment_max_error                 10.0

  :box_scale_factor                            1.10
  :box_min_aspect_ratio                        0.10

  # Track remapping (unified IDs, class averaging, length averaging)
  :output_unmatched                            true
  :average_stereo_classes                      true
  :length_aggregation_method                   median
  :class_averaging_method                      weighted_scaled_by_conf
  :class_averaging_ignore_class                UNKNOWNFISH

connect from tracker.object_track_set
        to   measurer.object_track_set1
connect from downsampler.output_1
        to   measurer.image1
connect from downsampler.output_3
        to   measurer.image2
connect from downsampler.timestamp
        to   measurer.timestamp

# ================================== WRITERS ==================================

process track_writer1
  :: write_object_track
  :file_name                                   computed_tracks1.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:top_n_classes              5
  :writer:coco:top_n_classes                   5
  :writer:viame_csv:write_time_as_uid          true

connect from measurer.object_track_set1
        to   track_writer1.object_track_set
connect from downsampler.timestamp
        to   track_writer1.timestamp
connect from downsampler.output_2
        to   track_writer1.image_file_name

process track_writer2
  :: write_object_track
  :file_name                                   computed_tracks2.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:top_n_classes              5
  :writer:coco:top_n_classes                   5
  :writer:viame_csv:write_time_as_uid          true

connect from measurer.object_track_set2
        to   track_writer2.object_track_set
connect from downsampler.timestamp
        to   track_writer2.timestamp
connect from downsampler.output_4
        to   track_writer2.image_file_name

# -- end of file --
