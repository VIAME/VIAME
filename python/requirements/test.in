# What `VIAME_ENABLE_TESTS` adds. Not in `base.in`, because a release
# install does not run the test suite.
# Compiled with the accelerator's lock as a constraint, so every version
# this shares with a default install is the same version. It deliberately
# does not `-r base.in`: this file is what the option *adds*, and the build
# installs it alongside the accelerator lock rather than instead of it.

pytest
