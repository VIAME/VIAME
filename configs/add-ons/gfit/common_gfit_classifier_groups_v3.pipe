# =============================================================================
# Title: GFIT v3 groups classifier
#
# Description: Single large classifier over the fused detections. Its output is
# blended with the detector's own class scores at prior_weight.
# =============================================================================

process classifier_groups_large
  :: refine_detections
  :refiner:type                                netharn

  block refiner:netharn
    relativepath deployed =                    models/gfit_groups_enetv2m_large.zip
    :batch_size                                auto
    :area_pivot                                0
    :chip_method                               native_square
    :chip_width                                224
    :chip_expansion                            1.3
    :average_prior                             true
    :prior_weight                              0.55
    :prior_ignore_class                        UNKNOWNFISH
  endblock

process classifier_groups_output
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.80
    :max_scale_difference                      10.0
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from classifier_groups_large.detected_object_set
        to   classifier_groups_output.detected_object_set

# -- end of file --
