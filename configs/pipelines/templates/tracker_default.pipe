# =============================================================================
# Title: Default Tracker Template
#
# Description: Runs detection and tracking on input imagery from disk. The
# detector slot is filled by detector training and the tracker parameters by
# tracker training in the same run.
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

# =============================================================================

# Standard image or video input plus downsampler
include $ENV{VIAME_INSTALL}/configs/pipelines/common_default_input_with_downsampler.pipe

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

connect from downsampler.output_1
        to   detector_input.image

# =============================================================================

process detector1
  :: image_object_detector
  [-DETECTOR-IMPL-]

connect from detector_input.image
        to   detector1.image

# =============================================================================

process detector_merger
  :: merge_detection_sets

connect from detector1.detected_object_set
        to   detector_merger.detected_object_set1

process detector_output
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.50
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from detector_merger.detected_object_set
        to   detector_output.detected_object_set

process detector_writer
  :: detected_object_output
  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv

connect from detector_output.detected_object_set
        to   detector_writer.detected_object_set
connect from downsampler.output_2
        to   detector_writer.image_file_name
connect from downsampler.timestamp
        to   detector_writer.timestamp

# =============================================================================

process tracker
  :: track_objects
  :track_objects:type                          bytetrack

  block track_objects:bytetrack
    :high_thresh                               [-HIGH-THRESH-]
    :low_thresh                                [-LOW-THRESH-]
    :match_thresh                              [-MATCH-THRESH-]
    :second_match_thresh                       [-SECOND-MATCH-THRESH-]
    :unconfirmed_match_thresh                  [-UNCONFIRMED-MATCH-THRESH-]
    :track_buffer                              [-TRACK-BUFFER-]
    :new_track_thresh                          [-NEW-TRACK-THRESH-]
    :std_weight_position                       [-STD-WEIGHT-POSITION-]
    :std_weight_velocity                       [-STD-WEIGHT-VELOCITY-]
  endblock

connect from downsampler.output_1
        to   tracker.image
connect from downsampler.timestamp
        to   tracker.timestamp
connect from detector_output.detected_object_set
        to   tracker.detected_object_set

process track_tot_averager
  :: refine_tracks
  :refiner:type                                average_tot
  :refiner:average_tot:tot_option              weighted_average

process track_writer
  :: write_object_track
  :file_name                                   computed_tracks.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:stream_identifier          input_list.txt
  :writer:viame_csv:tot_option                 detection

connect from tracker.object_track_set
        to   track_tot_averager.object_track_set
connect from track_tot_averager.object_track_set
        to   track_writer.object_track_set
connect from downsampler.timestamp
        to   track_writer.timestamp
connect from downsampler.output_2
        to   track_writer.image_file_name
