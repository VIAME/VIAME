# =============================================================================
# Title: Tracker Generic Svm Template
#
# Description: The generic-proposal SVM detector followed by a trained tracker,
# runnable directly on input imagery from disk. Detector training renders this
# alongside detector.pipe and tracker training fills in the tracker parameters.
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

# Standard image or video input plus downsampler
include $ENV{VIAME_INSTALL}/configs/pipelines/common_default_input_with_downsampler.pipe

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

# Kept in step with add-ons/generic/common_generic_detector.pipe.
process generic_detector
  :: image_object_detector
  :detector:type                               windowed

  block detector:windowed
    :mode                                      adaptive
    :original_to_chip_size                     true
    :chip_width                                704
    :chip_height                               704
    :chip_step_width                           480
    :chip_step_height                          480
    :chip_adaptive_thresh                      1400000
    :scale                                     1.0
    :black_pad                                 false

    :detector:type                             rf_detr

    block detector:rf_detr
      :model_size                              large
      :device                                  auto
      :weight $ENV{VIAME_INSTALL}/configs/pipelines/models/generic_rf_detr_704.pth
      :num_channels                            3
      :resolution                              704x704
      :segmentation                            false
    endblock
  endblock

connect from detector_input.image
        to   generic_detector.image

# =============================================================================

include $ENV{VIAME_INSTALL}/configs/pipelines/common_default_descriptor.pipe

process svm_refiner
  :: refine_detections
  :refiner:type                                svm
  relativepath refiner:svm:model_dir =         .

process nms_refiner
  :: refine_detections
  :refiner:type                                nms
  
  block refiner:nms
    :max_overlap                               0.50
    :nms_scale_factor                          1.5
    :output_scale_factor                       1.1
  endblock

connect from detector_input.image
        to   descriptor.image
connect from detector_input.image
        to   svm_refiner.image
connect from detector_input.image
        to   nms_refiner.image

connect from generic_detector.detected_object_set
        to   descriptor.detected_object_set
connect from descriptor.detected_object_set
        to   svm_refiner.detected_object_set
connect from svm_refiner.detected_object_set
        to   nms_refiner.detected_object_set

# =============================================================================

process detector_output
  :: merge_detection_sets

connect from nms_refiner.detected_object_set
        to   detector_output.detected_object_set1

connect from downsampler.output_1
        to   detector_input.image

# =============================================================================

process detector_writer
  :: detected_object_output
  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv

connect from detector_output.detected_object_set
        to   detector_writer.detected_object_set
connect from downsampler.output_2
        to   detector_writer.image_file_name
connect from downsampler.timestamp
        to   detector_writer.timestamp

# =============================================================================

process tracker
  :: track_objects
  :track_objects:type                          bytetrack

  block track_objects:bytetrack
    :high_thresh                               [-HIGH-THRESH-]
    :low_thresh                                [-LOW-THRESH-]
    :match_thresh                              [-MATCH-THRESH-]
    :second_match_thresh                       [-SECOND-MATCH-THRESH-]
    :unconfirmed_match_thresh                  [-UNCONFIRMED-MATCH-THRESH-]
    :track_buffer                              [-TRACK-BUFFER-]
    :new_track_thresh                          [-NEW-TRACK-THRESH-]
    :std_weight_position                       [-STD-WEIGHT-POSITION-]
    :std_weight_velocity                       [-STD-WEIGHT-VELOCITY-]
  endblock

connect from downsampler.output_1
        to   tracker.image
connect from downsampler.timestamp
        to   tracker.timestamp
connect from detector_output.detected_object_set
        to   tracker.detected_object_set

process track_writer
  :: write_object_track
  :file_name                                   computed_tracks.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:stream_identifier          input_list.txt

connect from tracker.object_track_set
        to   track_writer.object_track_set
connect from downsampler.timestamp
        to   track_writer.timestamp
connect from downsampler.output_2
        to   track_writer.image_file_name
