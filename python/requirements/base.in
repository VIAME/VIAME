# albumentations builds RF-DETR's resize to the configured training
# resolution, not only its augmentations; without it the transform pipeline
# yields zero transforms and the model trains on natively sized chips that
# inference never reproduces. It pins albucore exactly, and albucore needs
# simsimd and stringzilla, so all four move together.
albumentations==2.0.8
albucore==0.0.24
simsimd>=5.9.2
stringzilla>=3.10.4

# --- model hub -------------------------------------------------------------
# Needed by SAM2, SAM3, STEREO, LEARN and DETECTRON2; three of those five are
# on in a default build and all three packages are small, so they live here
# rather than in a file per option.
#
# Two things those options would have brought are deliberately absent.
# `decord` is 26 MB of video reader that only sam2, sam3 and pytorchvideo
# would use, and VIAME feeds them frames itself -- checked in P1-T07:
# nothing in VIAME, and nothing in any submodule this build compiles,
# imports it. `triton` is 697 MB, and sam3's `edt.py` is the only user: it
# takes a Triton kernel for its euclidean distance transform when one is
# there and an OpenCV CPU implementation when it is not, which is the path
# Windows already takes. See `lite-install-size.md` section 3, rows 11 and 2,
# and section 4, which asked for exactly these two checks first.
huggingface_hub
safetensors
timm

# --- onnx --------------------------------------------------------------------
# <=1.18 keeps compatibility with TensorRT < 10; onnxscript is needed by
# torch's exporter (pytorch/pytorch#166352). The runtime itself is chosen by
# the accelerator file, since it is `onnxruntime-gpu` or `onnxruntime`.
onnx<=1.18
onnxscript

