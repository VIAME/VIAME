# =============================================================================
# Title: Format Converter
#
# Description: Converts annotation data between different file formats without
# requiring the source imagery or videos to be present. Image names are pulled
# from the identifiers stored in the input annotation files instead.
#
# Tracks are read and written, so per-frame detections keep the track they
# belong to. A track reader cannot drive itself, so the detection reader reads
# the same file purely as a frame clock, supplying the frame identifiers the
# track reader and the writer need.
# =============================================================================

config _pipeline:_edge
  :capacity                                                      5

config _scheduler
  :type                                       pythread_per_process

# ============================== CONVERTER FUNC ===============================

process detection_reader
  :: detected_object_input
  :file_name                                             input.csv
  :reader:type                                           viame_csv

process track_reader
  :: read_object_track
  :file_name                                             input.csv
  :reader:type                                           viame_csv

process detector_writer
  :: write_object_track
  :file_name                                           output.json
  :writer:type                                                coco

connect from detection_reader.image_file_name
        to   track_reader.image_file_name
connect from track_reader.object_track_set
        to   detector_writer.object_track_set
connect from detection_reader.image_file_name
        to   detector_writer.image_file_name

# -- end of file --
