# =============================================================================
# Title: Common - Default Fish Fusion Detector, Suppressed
#
# Description: DEIMv2 on color fused with an RF-DETR run over a motion-infused
# channel stack, with each detector's overlapping boxes suppressed before the
# fusion. This is the detector the TreeLink fish tracker was fitted behind.
# =============================================================================

# ============================== COLOR MODEL ==================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector
  :: image_object_detector
  :detector:type                               onnx

  block detector:onnx
    relativepath model =                       models/fish_deim_v2_1024.zip
    :device                                    cuda
    :score_thresh                              0.10
    :nms_thresh                                0.50
  endblock

connect from detector_input.image
        to   detector.image

process detector_nms
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.50
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from detector.detected_object_set
        to   detector_nms.detected_object_set

process detector_output
  :: merge_detection_sets

connect from detector_nms.detected_object_set
        to   detector_output.detected_object_set1

# ============================= MOTION CHANNELS ===============================
# Greyscale between two temporal-variance channels: [variance@5, grey,
# variance@30], which is the input stack the motion model was trained on.

process detector_grey
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :single_channel                            true
  endblock

connect from detector_input.image
        to   detector_grey.image

process motion_filter1
  :: image_filter
  :filter:type                                 vxl_average

  block filter:vxl_average
    :type                                      window
    :window_size                               5
    :round                                     false
    :output_variance                           true
  endblock

connect from detector_grey.image
        to   motion_filter1.image

process float_to_byte1
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :scale_factor                              0.50
  endblock

connect from motion_filter1.image
        to   float_to_byte1.image

process motion_filter2
  :: image_filter
  :filter:type                                 vxl_average

  block filter:vxl_average
    :type                                      window
    :window_size                               30
    :round                                     false
    :output_variance                           true
  endblock

connect from detector_grey.image
        to   motion_filter2.image

process float_to_byte2
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :scale_factor                              0.50
  endblock

connect from motion_filter2.image
        to   float_to_byte2.image

process image_merger1
  :: merge_images
  :merge_images:type                           ocv

connect from float_to_byte1.image
        to   image_merger1.image1
connect from detector_grey.image
        to   image_merger1.image2

process image_merger2
  :: merge_images
  :merge_images:type                           ocv

connect from image_merger1.image
        to   image_merger2.image1
connect from float_to_byte2.image
        to   image_merger2.image2

# ============================== MOTION MODEL =================================

process motion_detector
  :: image_object_detector
  :detector:type                               rf_detr

  block detector:rf_detr
    :model_size                                large
    :device                                    auto
    relativepath weight =                      models/fish_rf_detr_variance_1728.pth
    :num_channels                              3
    :segmentation                              false
    :resolution                                960x1728
    :threshold                                 0.10
  endblock

connect from image_merger2.image
        to   motion_detector.image

process motion_nms
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.50
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from motion_detector.detected_object_set
        to   motion_nms.detected_object_set

# ================================= FUSION ====================================
# Equal-weight weighted box fusion of the two suppressed detection sets.

config detector_output
  :merger:type                                        nms_fusion
  block merger:nms_fusion
    :fusion_type                                      wbf
    :fusion_weights                                   [ 1.0, 1.0 ]
    :iou_thr                                          0.50
    :skip_box_thr                                     0.0001
    :label_dic                                        { 'fish': 0 }
  endblock

connect from motion_nms.detected_object_set
        to   detector_output.detected_object_set2

# -- end of file --
