# =============================================================================
# Title: Adaptive Optical Flow Channel Augmentation
#
# Description: Appends a background-compensated optical-flow magnitude channel
# scaled per frame to its 99th percentile: [R, G, B, flow]. Frames must be in
# temporal order.
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

# ============================= FRAME SOURCE =================================
# video_input; reader switches between vidl_ffmpeg (video) and image_list
# (image sequence) via -s input:video_reader:type at run time.

include common_default_input_with_downsampler.pipe

# ========================== OPTICAL-FLOW AUGMENTATION ========================

process ensure_color
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

connect from downsampler.output_1
        to   ensure_color.image

process motion_filter
  :: image_filter
  :filter:type                                 ocv_optical_flow

  block filter:ocv_optical_flow
    :output                                    magnitude
    # Adaptive rather than a fixed 8 px full scale. Magnitude at 5 fps spans
    # roughly 0.01-1.24 px at the 95th percentile across this corpus, so a fixed
    # 8 px leaves most sequences encoded into the bottom few percent of the byte
    # range. Per-frame percentile scaling spends the range on the motion each
    # frame actually has; the floor keeps genuinely still footage dark instead
    # of amplifying its noise to full scale.
    :normalize                                 adaptive
    :adaptive_percentile                       99.0
    :adaptive_min_scale                        0.5
    :scale                                     8.0
    :compensate_background                     true
  endblock

connect from ensure_color.image
        to   motion_filter.image

# =============================================================================

process image_merger
  :: merge_images
  :merge_images:type                           ocv

connect from ensure_color.image
        to   image_merger.image1
connect from motion_filter.image
        to   image_merger.image2

# ================================== OUTPUT ===================================
# Frame names come solely from the template counter (set by the train tool), so
# numbering is identical whether the source is a video or an image list, and the
# original images are never overwritten.

process image_writer
 :: image_writer
 :file_name_template                            frame%06d.png
 :image_writer:type                             vxl
 :image_writer:vxl:split_channels               false

connect from image_merger.image
        to   image_writer.image

# -- end of file --
