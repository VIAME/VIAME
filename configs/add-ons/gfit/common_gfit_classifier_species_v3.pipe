# =============================================================================
# Title: GFIT v3 Species Classifier
#
# Description: NetHarn species classifier over the fused detections. Group
# scores are blended in through the group-to-species taxonomy.
# =============================================================================

process classifier_species_large
  :: refine_detections
  :refiner:type                                netharn

  block refiner:netharn
    relativepath deployed =                    models/gfit_species_enetv2m_large.zip
    :batch_size                                auto
    :area_pivot                                0
    :chip_method                               native_square
    :chip_width                                224
    :chip_expansion                            1.3
    :average_prior                             true
    :prior_weight                              0.65
    relativepath prior_taxonomy_file =         models/gfit_groupings.txt
  endblock

process classifier_species_output
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.80
    :max_scale_difference                      10.0
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from classifier_species_large.detected_object_set
        to   classifier_species_output.detected_object_set

# -- end of file --
