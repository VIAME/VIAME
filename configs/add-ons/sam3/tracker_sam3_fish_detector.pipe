# =============================================================================
# Tracker - SAM 3.1 on Fish Detector Detections
#
# Description: Tracks the default fish detector's detections with SAM 3.1
# mask propagation. Each detection either continues an object SAM 3.1 is
# already tracking or seeds a new one; SAM 3.1's own text-query detector is
# not used. Produces polygon tracks.
# GPU Memory: 15.9 GB if <=1920x1080 else 23.9 GB
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

# ============================== INPUT FRAME LIST =============================

include common_default_input_with_downsampler.pipe

# ================================= DETECTOR ==================================
# The default fish detector (RF-DETR plus a motion model, fused). Any include
# that declares detector_input and detector_output can be swapped in.

include common_fish_detector_motion_fusion.pipe

connect from downsampler.output_1
        to   detector_input.image

process detector_writer
  :: detected_object_output
  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv
connect from detector_output.detected_object_set
        to   detector_writer.detected_object_set
connect from downsampler.output_2
        to   detector_writer.image_file_name
connect from downsampler.timestamp
        to   detector_writer.timestamp

# ================================= TRACKER ===================================

process tracker
  :: refine_tracks
  :refiner:type                                sam3
  block refiner:sam3
    :grounding_model_id                        none
    :device                                    cuda
    :text_query                                fish
    :min_mask_area                             10
    :filter_by_quality                         true
    :adjust_boxes                              true
    :output_type                               polygon
    :polygon_simplification                    0.005
    :propagate_tracked                         true
    # Detections come in on the object_track_set port; no text detection.
    :add_new_objects                           false
    :link_input_detections                     true
    :preserve_seed_ids                         true
    # Seed a new object only from a detection at least this confident that
    # overlaps no object already being tracked (IoU < link_iou). Objects
    # with no supporting detection for link_max_gap frames can be re-seeded.
    # Tuned on the FishTrack pipeline eval (46 videos): versus 0.40 / gap 5,
    # MOTA 0.080 -> 0.164 and ID switches 375 -> 264 at the same IDF1.
    :detections_threshold                      0.55
    :link_iou                                  0.30
    :link_max_gap                              30
    :max_seed_objects                          32
    :max_tracked_objects                       32
    :video_hotstart_delay                      0
    relativepath sam_model_id =                models/sam3.1_weights.pt
    relativepath model_config =                models/sam3.1_config.json
  endblock
connect from detector_input.image
        to   tracker.image
connect from downsampler.timestamp
        to   tracker.timestamp

# Each frame's detections become single-state tracks, which the refiner
# links to the objects SAM 3.1 is already propagating.
process detection_tracks
  :: initialize_object_tracks
  :track_initializer:type                      threshold
  block track_initializer:threshold:filter
    :type                                      class_probability_filter
    :class_probability_filter:threshold        0.0
    :class_probability_filter:keep_all_classes true
    :class_probability_filter:keep_classes     unused
  endblock
connect from downsampler.timestamp
        to   detection_tracks.timestamp
connect from detector_output.detected_object_set
        to   detection_tracks.detected_object_set
connect from detection_tracks.object_track_set
        to   tracker.object_track_set

process track_classifier
  :: refine_tracks
  :refiner:type                                average_tot
  :refiner:average_tot:tot_option              weighted_average

process track_writer
  :: write_object_track
  :file_name                                   computed_tracks.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:mask_to_poly_points        30
connect from downsampler.output_2
        to   track_writer.image_file_name
connect from downsampler.timestamp
        to   track_writer.timestamp
connect from tracker.object_track_set
        to   track_classifier.object_track_set
connect from track_classifier.object_track_set
        to   track_writer.object_track_set

# -- end of file --
