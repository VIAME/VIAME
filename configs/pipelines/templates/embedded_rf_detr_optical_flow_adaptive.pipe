# =============================================================================
# Title: Embedded RF-DETR Adaptive Optical Flow Detector Template
#
# Description: As the embedded optical flow template, with adaptive per-frame
# flow normalization matching the adaptive optical-flow training augmentation.
# =============================================================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process motion_filter
  :: image_filter
  :filter:type                                 ocv_optical_flow

  block filter:ocv_optical_flow
    :output                                    magnitude
    # Adaptive rather than a fixed 8 px full scale. Magnitude at 5 fps spans
    # roughly 0.01-1.24 px at the 95th percentile across this corpus, so a fixed
    # 8 px leaves most sequences encoded into the bottom few percent of the byte
    # range. Per-frame percentile scaling spends the range on the motion each
    # frame actually has; the floor keeps genuinely still footage dark instead
    # of amplifying its noise to full scale.
    :normalize                                 adaptive
    :adaptive_percentile                       99.0
    :adaptive_min_scale                        0.5
    :scale                                     8.0
    :compensate_background                     true
  endblock

connect from detector_input.image
        to   motion_filter.image

# =============================================================================

process image_merger
  :: merge_images
  :merge_images:type                           ocv

connect from detector_input.image
        to   image_merger.image1
connect from motion_filter.image
        to   image_merger.image2

# =============================================================================

process detector1
  :: image_object_detector
  [-DETECTOR-IMPL-]

connect from image_merger.image
        to   detector1.image

# =============================================================================

process detector_merger
  :: merge_detection_sets

connect from detector1.detected_object_set
        to   detector_merger.detected_object_set1

process detector_output
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.50
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from detector_merger.detected_object_set
        to   detector_output.detected_object_set
