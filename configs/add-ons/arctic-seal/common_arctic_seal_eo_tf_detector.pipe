# =============================================================================
# Title: Arctic Seal EO TensorFlow Detector
#
# Description: TensorFlow seal detector for optical imagery, shared by the
# arctic seal pipelines.
# Input: IMAGE
# Output: BBOX
# =============================================================================

process optical_detector
  :: image_object_detector
  :detector:type                               tensorflow

  block detector:tensorflow
    relativepath model_file =                  models/arctic_seal_eo.pb
    :confidence_thresh                         0.10         # DIVE_PARAM["Confidence Threshold", range_float, 0, 1, 0.01]
    :category_name                             seal
  endblock
