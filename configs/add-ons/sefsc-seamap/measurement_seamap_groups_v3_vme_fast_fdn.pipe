connect from detector_grey_r.image
        to   motion_filter1_r.image
connect from motion_filter1_r.image
        to   float_to_byte1_r.image
connect from detector_grey_r.image
        to   motion_filter2_r.image
connect from motion_filter2_r.image
        to   float_to_byte2_r.image
connect from float_to_byte1_r.image
        to   image_merger1_r.image1
connect from detector_grey_r.image
        to   image_merger1_r.image2
connect from image_merger1_r.image
        to   image_merger2_r.image1
connect from float_to_byte2_r.image
        to   image_merger2_r.image2

