# =============================================================================
# Title: Common - Default Fish Fusion Detector
#
# Description: DEIMv2 on color fused with an RF-DETR run over a motion-infused
# channel stack. The two disagree in useful ways -- the variance model carries
# temporal evidence the color model cannot see -- and the pair is the
# highest-scoring detector configuration we have measured on FishTrack.
# =============================================================================

include common_fish_detector_box_only.pipe

# ============================= MOTION CHANNELS ===============================
# Greyscale between two temporal-variance channels: [variance@5, grey,
# variance@30], which is the input stack the motion model was trained on.

process detector_grey
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :single_channel                            true
  endblock

connect from detector_input.image
        to   detector_grey.image

process motion_filter1
  :: image_filter
  :filter:type                                 vxl_average

  block filter:vxl_average
    :type                                      window
    :window_size                               5
    :round                                     false
    :output_variance                           true
  endblock

connect from detector_grey.image
        to   motion_filter1.image

process float_to_byte1
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :scale_factor                              0.50
  endblock

connect from motion_filter1.image
        to   float_to_byte1.image

process motion_filter2
  :: image_filter
  :filter:type                                 vxl_average

  block filter:vxl_average
    :type                                      window
    :window_size                               30
    :round                                     false
    :output_variance                           true
  endblock

connect from detector_grey.image
        to   motion_filter2.image

process float_to_byte2
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :scale_factor                              0.50
  endblock

connect from motion_filter2.image
        to   float_to_byte2.image

process image_merger1
  :: merge_images
  :merge_images:type                           ocv

connect from float_to_byte1.image
        to   image_merger1.image1
connect from detector_grey.image
        to   image_merger1.image2

process image_merger2
  :: merge_images
  :merge_images:type                           ocv

connect from image_merger1.image
        to   image_merger2.image1
connect from float_to_byte2.image
        to   image_merger2.image2

# ============================== MOTION MODEL =================================

process motion_detector
  :: image_object_detector
  :detector:type                               rf_detr

  block detector:rf_detr
    :model_size                                large
    :device                                    auto
    relativepath weight =                      models/fish_rf_detr_variance_1728.pth
    :num_channels                              3
    :segmentation                              false
    :resolution                                960x1728
    :threshold                                 0.10
  endblock

connect from image_merger2.image
        to   motion_detector.image

# ================================= FUSION ====================================
# detector_output is declared by common_fish_detector_box.pipe; this turns it
# into the fusion and gives it the motion model as its second input.

config detector_output
  :merger:type                                        nms_fusion
  block merger:nms_fusion
    :fusion_type                                      wbf
    :fusion_weights                                   [ 1.0, 1.0 ]
    :iou_thr                                          0.50
    :skip_box_thr                                     0.0001
    :label_dic                                        { 'fish': 0 }
  endblock

connect from motion_detector.detected_object_set
        to   detector_output.detected_object_set2

# -- end of file --
