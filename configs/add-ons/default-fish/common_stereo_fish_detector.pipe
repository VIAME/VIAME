# =============================================================================
# Title: Common - Stereo Fish Detector
#
# Description: Stereo fish detector. Runs the same 960x1728 RF-DETR
# segmentation model as common_fish_detector_mask.pipe on each camera, so both
# views emit box + mask output.
# =============================================================================

process detector_input1
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector1
  :: image_object_detector
  :detector:type                               rf_detr

  block detector:rf_detr
    :model_size                                large
    :device                                    auto
    relativepath weight =                      models/fish_rf_detr_seg_1728.pth
    :num_channels                              3
    :segmentation                              true
    :resolution                                960x1728
    :threshold                                 0.10
  endblock

connect from detector_input1.image
        to   detector1.image

process detector_output1
  :: merge_detection_sets

connect from detector1.detected_object_set
        to   detector_output1.detected_object_set1

# =============================================================================

process detector_input2
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector2
  :: image_object_detector
  :detector:type                               rf_detr

  block detector:rf_detr
    :model_size                                large
    :device                                    auto
    relativepath weight =                      models/fish_rf_detr_seg_1728.pth
    :num_channels                              3
    :segmentation                              true
    :resolution                                960x1728
    :threshold                                 0.10
  endblock

connect from detector_input2.image
        to   detector2.image

process detector_output2
  :: merge_detection_sets

connect from detector2.detected_object_set
        to   detector_output2.detected_object_set1

# -- end of file --
