# =============================================================================
# Title: Add head tail keypoints from the SLEAP-NN model to existing boxes
#
# Description: Crops each existing detection and runs the trained SLEAP-NN
# keypoint model on it, adding head and tail points. Boxes, classes and
# detection IDs are kept as they are.
# Input: BBOX
# Output: HEAD-TAIL
# =============================================================================

config _pipeline:_edge
  :capacity                                                      5

# ============================= INPUT FRAME LIST ==============================

process input
  :: video_input
  :video_filename                                   input_list.txt
  :frame_time                                              0.03333
  :video_reader:type                                    image_list
  :video_reader:image_list:image_reader:type                   vxl

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detection_reader
  :: detected_object_input
  :file_name                                        detections.csv
  :reader:type                                           viame_csv
  :reader:viame_csv:poly_to_mask                              true

# =============================== KEYPOINTS ===================================

process add_head_tail
  :: refine_detections
  :refiner:type                                sleap

  block refiner:sleap
    relativepath weight =                      models/default_fish_keypoint_refiner.pt
    :device                                    auto
    :batch_size                                16
    :keypoint_threshold                        0.2
    :overwrite_existing                        false     # DIVE_PARAM["Replace existing keypoints", bool]
  endblock

# ================================== OUTPUT ===================================

process detector_writer
  :: detected_object_output
  :file_name                               computed_detections.csv
  :writer:type                                           viame_csv
  :writer:viame_csv:mask_to_poly_points                         30

connect from input.image
        to   detector_input.image
connect from detector_input.image
        to   add_head_tail.image
connect from detection_reader.detected_object_set
        to   add_head_tail.detected_object_set
connect from add_head_tail.detected_object_set
        to   detector_writer.detected_object_set
connect from input.file_name
        to   detector_writer.image_file_name
connect from input.timestamp
        to   detector_writer.timestamp

# -- end of file --
