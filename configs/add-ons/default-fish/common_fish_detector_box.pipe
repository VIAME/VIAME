# =============================================================================
# Title: Default Fish Detector
#
# Description: Detects a single 'fish' output category via running a 960x1728
# RF-DETR model on RGB inputs. Produces just a bounding box output.
# =============================================================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector
  :: image_object_detector
  :detector:type                               rf_detr

  block detector:rf_detr
    :model_size                                large
    :device                                    auto
    relativepath weight =                      models/fish_rf_detr_box_1728.pth
    :num_channels                              3
    :segmentation                              false
    :resolution                                960x1728
    :threshold                                 0.10
  endblock

connect from detector_input.image
        to   detector.image

process detector_output
  :: merge_detection_sets

connect from detector.detected_object_set
        to   detector_output.detected_object_set1

# -- end of file --
