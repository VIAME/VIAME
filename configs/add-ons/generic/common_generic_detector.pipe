# =============================================================================
# Title: Generates generic object proposals as opposed to specific class labels
#
# Description: Generates single-class generic object proposals
# =============================================================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector
  :: image_object_detector
  :detector:type                               ocv_windowed
  
  block detector:ocv_windowed
    :mode                                      adaptive
    :original_to_chip_size                     true
    :chip_width                                704
    :chip_height                               704
    :chip_step_height                          480
    :chip_step_width                           480
    :chip_adaptive_thresh                      1500000
    :scale                                     1.0
    :black_pad                                 false
  endblock

  :detector:ocv_windowed:detector:type         rf_detr

  block detector:ocv_windowed:detector:rf_detr
    :model_size                                large
    :device                                    auto
    relativepath weight =                      models/generic_rf_detr_704.pth
    :num_channels                              3
    :resolution                                704x704
    :segmentation                              false
  endblock

connect from detector_input.image
        to   detector1.image

process detector_output
  :: refine_detections
  :refiner:type                                nms

  block refiner:nms
    :max_overlap                               0.5
    :nms_scale_factor                          1.0
    :output_scale_factor                       1.0
  endblock

connect from detector.detected_object_set
        to   detector_output.detected_object_set1

# -- end of file --
