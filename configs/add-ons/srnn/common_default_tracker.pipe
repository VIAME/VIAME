# =============================================================================
# Title: Common - Default Tracker
#
# Description: Multi-object tracker used by the default tracking pipelines.
# ByteTrack (the base VIAME default) associates detections by IoU with a
# two-stage strategy for high and low confidence detections. The SRNN
# alternative is a modified "Tracking the Untrackable" appearance tracker
# implemented in pytorch and trained on assorted fish data, using the models
# srnn_siamese.pt, srnn_rnn_f.pt and srnn_rnn_v.pt from this add-on.
# =============================================================================

process tracker
  :: track_objects
  :track_objects:type                          bytetrack  # DIVE_PARAM ["Tracker", choice, bytetrack, srnn]

block track_objects:bytetrack

  # Tuned on FishTrack23 over RF-DETR rgb_1728 detections.

  # Confidence threshold for the first (high-confidence) association stage
  :high_thresh                                 0.75097625

  # Confidence threshold for the second (low-confidence) association stage
  :low_thresh                                  0.27399542

  # IoU distance bound for the first association pass
  :match_thresh                                0.98

  # IoU distance bound for the second (low-confidence) association pass
  :second_match_thresh                         0.98

  # IoU distance bound for matching unconfirmed, single-hit tracks
  :unconfirmed_match_thresh                    0.98

  # Number of frames to keep lost tracks before removal
  :track_buffer                                17

  # Minimum confidence to initialize a new track
  :new_track_thresh                            0.8049812

  # Kalman position and velocity uncertainty weights
  :std_weight_position                         0.26666666666666666
  :std_weight_velocity                         0.17804493814764857

endblock

block track_objects:srnn
  :siamese_model_input_size                    224
  :detection_select_threshold                  0.001
  :similarity_threshold                        0.200
  :terminate_track_threshold                   10
  :add_features_to_detections                  False
  :IOU_tracker_flag                            True
  :IOU_accept_threshold                        0.500
  :IOU_reject_threshold                        0.100
  :track_search_threshold                      2
  :gpu_list                                    0

  relativepath siamese_model_path =            models/srnn_siamese.pt
  :siamese_batch_size                          64

  relativepath targetRNN_AIM_model_path =      models/srnn_rnn_f.pt
  relativepath targetRNN_AIM_V_model_path =    models/srnn_rnn_v.pt
  :targetRNN_normalized_models                 True
  :targetRNN_batch_size                        128
endblock

# -- end of file --
