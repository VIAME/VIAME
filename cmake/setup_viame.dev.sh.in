###############################################################################
#       This script sets up all paths required for standard VIAME Usage       #
###############################################################################

@SETUP_PYTHON_LOCATION@

# Nothing here names a plugin directory: every built-in plugin is linked in.
# `VIAME_PLUGIN_PATH` and `VIAME_PYTHON_PLUGINS` load add-ons and are unset
# unless you set them.
@SETUP_READLINK_CMD@

# Setup VIAME install path
export VIAME_INSTALL=$this_dir

# Core python locations
export PYTHONPATH=$this_dir/lib/@VIAME_PYTHON_STRING@/site-packages:$PYTHONPATH
export PYTHONNOUSERSITE=1
export LD_LIBRARY_PATH=$PYTHON_INSTALL_DIR/lib:$LD_LIBRARY_PATH

# Default log level. `KWIVER_DEFAULT_LOG_LEVEL`, the old name, is still read
# when this is unset.
export VIAME_LOG_LEVEL=${VIAME_LOG_LEVEL:-${KWIVER_DEFAULT_LOG_LEVEL:-debug}}

# Paths for adding exes to path (must occur after python)
export PATH=$this_dir/bin:$PATH
@SETUP_LIBRARY_PATH@

# Show when VIAME is sourced in terminal without duplicates
@SETUP_CUSTOM_TERMINAL@
