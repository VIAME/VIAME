# =============================================================================
# Title: VIAME CSV to COCO JSON Converter (GT Only)
#
# Description: Converts VIAME CSV to COCO JSON without the imagery present.
# Frame names come from the CSV itself.
# =============================================================================

config _pipeline:_edge
  :capacity                                                      5

config _scheduler
  :type                                       pythread_per_process

# ============================== CONVERTER FUNC ===============================

process detection_reader
  :: detected_object_input
  :file_name                                             input.csv
  :reader:type                                           viame_csv

process track_reader
  :: read_object_track
  :file_name                                             input.csv
  :reader:type                                           viame_csv

process detector_writer
  :: write_object_track
  :file_name                                           output.json
  :writer:type                                                coco

connect from detection_reader.image_file_name
        to   track_reader.image_file_name
connect from track_reader.object_track_set
        to   detector_writer.object_track_set
connect from detection_reader.image_file_name
        to   detector_writer.image_file_name

# -- end of file --
