        to   add_head_tail_r.image
connect from add_segmentations_r.detected_object_set
        to   add_head_tail_r.detected_object_set

# ========================== RIGHT CAMERA TRACKER =============================

process tracker_r
  :: track_objects
  :track_objects:type                          srnn

block track_objects:srnn
  :siamese_model_input_size                    224
  :detection_select_threshold                  0.001
  :similarity_threshold                        0.200
  :terminate_track_threshold                   10
  :add_features_to_detections                  False
  :IOU_tracker_flag                            True
  :IOU_accept_threshold                        0.500
  :IOU_reject_threshold                        0.100
  :track_search_threshold                      2
  :gpu_list                                    0

  relativepath siamese_model_path =            models/fishtrack_srnn_siamese.pt
  :siamese_batch_size                          64

  relativepath targetRNN_AIM_model_path =      models/fishtrack_srnn_rnn_f.pt
  relativepath targetRNN_AIM_V_model_path =    models/fishtrack_srnn_rnn_v.pt
  :targetRNN_normalized_models                 True
  :targetRNN_batch_size                        128
endblock

connect from downsampler.output_3
        to   tracker_r.image
connect from downsampler.timestamp
        to   tracker_r.timestamp
connect from add_head_tail_r.detected_object_set
        to   tracker_r.detected_object_set

# ============================= CORE MEASUREMENT ==============================
# Measurement process now handles track pairing internally via the shared
# stereo_track_pairer. Detection pairing uses keypoint_projection to match
# unmatched left/right detections before measuring.

process measurer
  :: compute_measurements
  relativepath calibration_file =              models/seamap-cal.json
  :min_track_states                            6

  :matching_methods                            input_pairs_only,compute_disparity,template_matching

  # Fast-Foundation-Stereo ONNX backend. Expects model.onnx + sidecar
  # model.yaml (image_size) at models/fast-fdn-stereo.{onnx,yaml}.
  :stereo_disparity:type                       fast_foundation_stereo_onnx

  block stereo_disparity:fast_foundation_stereo_onnx
    relativepath model_path =                  models/fast-fdn-stereo.onnx
    :backend                                   auto
    :device                                    auto
    :output_mode                               disparity
    :remove_invisible                          true
  endblock

  # Snap right keypoints to disparity-implied matches of their left
  # counterparts; falls back to the tracker keypoint where disparity is
  # invalid.
  :refine_keypoints_with_disparity             true
  :refine_keypoints_disparity_window           7
  # Reject the track when the tracker's right keypoint and the disparity-
  # implied position disagree by more than this fraction of the L bbox
  # max(width, height); guards against bad SAM2 / head-tail extractions
  # that would corrupt the length measurement.
  :refine_keypoints_reject_inconsistent        true
  :refine_keypoints_max_distance               0.25

  # Hybrid pairing: disparity_projection first (uses measured depth),
  # keypoint_projection as fallback. Threshold serves both: max centroid
  # distance in px for disparity_projection, max reprojection error in
  # px for keypoint_projection.
  :detection_pairing_method                    disparity_projection,keypoint_projection
  :detection_pairing_threshold                 100.0
  :detection_pairing_require_class_match       false

  # Per-frame pair-quality filters. The rig has a non-trivial vertical
  # baseline (cal T_y ~ -177 mm), so y-offset and area-ratio are kept
  # loose; stereo_rms is the primary geometry gate.
  :max_stereo_rms                              20.0
  :max_bbox_y_center_offset                    200.0
  :max_bbox_area_ratio                         3.0

  # Accumulate pairings across the stream and resolve once at finalize so
  # output track IDs don't shift mid-run.
  :accumulate_track_pairings                   true
  :pairing_resolution_method                   most_likely
  :output_unmatched                            true
  :average_stereo_classes                      true
  :class_averaging_method                      weighted_scaled_by_conf
  :class_averaging_ignore_class                UNKNOWNFISH
  :length_aggregation_method                   median

connect from tracker_l.object_track_set
        to   measurer.object_track_set1
connect from tracker_r.object_track_set
        to   measurer.object_track_set2
connect from downsampler.output_1
        to   measurer.image1
connect from downsampler.output_3
        to   measurer.image2
connect from downsampler.timestamp
        to   measurer.timestamp

# ================================== WRITERS ==================================

process track_writer1
  :: write_object_track
  :file_name                                   computed_tracks1.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:write_time_as_uid          true
  :writer:viame_csv:tot_option                 detection

connect from measurer.object_track_set1
        to   track_writer1.object_track_set
connect from downsampler.timestamp
        to   track_writer1.timestamp
connect from downsampler.output_2
        to   track_writer1.image_file_name

process track_writer2
  :: write_object_track
  :file_name                                   computed_tracks2.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:write_time_as_uid          true
  :writer:viame_csv:tot_option                 detection

connect from measurer.object_track_set2
        to   track_writer2.object_track_set
connect from downsampler.timestamp
        to   track_writer2.timestamp
connect from downsampler.output_4
        to   track_writer2.image_file_name

# -- end of file --
