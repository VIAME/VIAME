// Generated by `viame_write_static_registry` from the libraries that called
// `viame_register_statically`. Do not edit; edit
// `library/algorithm_framework/registry/static_registry.cxx.in`.

#include <viame/algorithm_framework/registry/static_registry.h>

#include <viame/algorithm_framework/registry/external_plugins.h>

#include <viame/algorithm_framework/plugin/registry.h>
#include <viame/algorithm_framework/plugin/plugin_manager.h>

// Each library's `register_factories`, renamed at compile time so that all of
// them can be linked into one program. See
// `cmake/viame_static_registration.cmake`.
@declarations@
namespace viame {

namespace {

using pm = viame::plugin_manager;

} // namespace

void
register_builtins(
  viame::registry& loader,
  viame::plugin_manager::plugin_types types )
{
@calls@
  // Nothing built in is registering any more, and a factory added after this
  // should not be attributed to the last library in the list.
  loader.set_registering_library( {} );

  // Then anything VIAME was not built with. Once, on the first call: the
  // plugins named by `VIAME_PLUGIN_PATH` register whatever they register,
  // which is not a kind this can select on.
  static bool external_done = false;

  if( !external_done )
  {
    external_done = true;
    register_external_plugins( loader );
  }
}

} // namespace viame

namespace {

// Hand the registry to the plugin manager as the library loads. Nothing calls
// `register_builtins` by name, so this is what connects the two: an
// executable that links this library gets every built-in factory, and one
// that does not gets none and pays nothing.
//
// Being linked at all is not automatic -- the toolchain drops a library no
// symbol reaches -- which is why `viame::registry` carries
// `-Wl,--no-as-needed`.
struct static_registrar
{
  static_registrar()
  {
    viame::plugin_manager::add_static_registrar(
      &viame::register_builtins );
  }
};

static static_registrar const s_static_registrar;

} // namespace
