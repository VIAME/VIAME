# =============================================================================
# Title: Embedded Detector LitDet Template
#
# Description: Embedded LitDet detector pipeline, meant to be included in
# other pipelines (e.g., by DIVE or tracker pipelines).
# =============================================================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector
  :: image_object_detector
  :detector:type                               litdet

  relativepath detector:litdet:checkpoint =    model.pth
  :detector:litdet:threshold                   0.5
  :detector:litdet:device                      auto

connect from detector_input.image
        to   detector.image

# =============================================================================

process detector_output
  :: merge_detection_sets

connect from detector.detected_object_set
        to   detector_output.detected_object_set1