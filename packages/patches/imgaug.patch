+def _border_constant(arr, cval):
+    """A border colour with exactly one value per plane of `arr`.
+
+    The warps want one constant for each plane. A caller here may hand over a
+    triple for a single-plane array, or one number for a colour one, and the
+    old behaviour for each is kept: extra components are dropped, and a bare
+    number fills the first plane and leaves the rest at zero.
+    """
+    planes = 1 if arr.ndim == 2 else arr.shape[-1]
+
+    if np.isscalar(cval):
+        if planes == 1:
+            return float(cval)
+        return [float(cval)] + [0.0] * (planes - 1)
+
+    values = [float(v) for v in np.asarray(cval).reshape(-1)]
+    values = (values + [0.0] * planes)[:planes]
+
+    return values[0] if planes == 1 else values
