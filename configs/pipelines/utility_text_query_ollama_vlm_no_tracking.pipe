# =============================================================================
# Title: Text query via an Ollama vision-language model (per-frame, no tracking)
#
# Description: Utility pipeline for detecting objects with text-based queries
#              on every frame using a vision-language model served locally by
#              Ollama (e.g. ollama pull qwen3-vl:8b). Each frame is processed
#              independently with no cross-frame tracking.
#
# Input: TEXT
# Output: BOX
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

# ============================= INPUT FRAME LIST ==============================
include common_default_input_with_downsampler.pipe

process track_reader
  :: read_object_track
  :file_name                                   detections.csv
  :reader:type                                 viame_csv
  :reader:viame_csv:poly_to_mask               false

connect from downsampler.output_2
        to   track_reader.image_file_name

process ensure_rgb
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

connect from downsampler.output_1
        to   ensure_rgb.image

# =============================== TRACK REFINER ===============================
process track_refiner
  :: refine_tracks
  :refiner:type                                ollama_vlm

  block refiner:ollama_vlm
    :model                                     qwen3-vl:8b  # DIVE_PARAM["Model", string]
    :text_query                                object  # DIVE_PARAM["Text Query", string, required]
    :think                                     false
    :replace_existing                          true  # DIVE_PARAM["Replace existing annotations", bool]
    :max_new_objects                           50  # DIVE_PARAM["Max new objects", strictly_positive_int]
  endblock

connect from ensure_rgb.image
        to   track_refiner.image
connect from downsampler.timestamp
        to   track_refiner.timestamp
connect from track_reader.object_track_set
        to   track_refiner.object_track_set

# =============================== OUTPUT WRITER ===============================
process track_writer
  :: write_object_track
  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv

connect from downsampler.output_2
        to   track_writer.image_file_name
connect from downsampler.timestamp
        to   track_writer.timestamp
connect from track_refiner.object_track_set
        to   track_writer.object_track_set

# -- end of file --
