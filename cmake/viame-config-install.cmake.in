# The config package for building a plugin against an installed VIAME
#
# This replaces the one kwiver installed. The target names keep the `kwiver::`
# namespace they have always had -- phase 11 is what renames them -- so an
# out-of-tree plugin that linked `kwiver::vital` still does.

set(fletch_DIR "@fletch_DIR@" CACHE PATH
  "The directory containing a CMake configuration file for fletch."
  )

include("${CMAKE_CURRENT_LIST_DIR}/viame-config-targets.cmake")

set(VIAME_LIBRARIES            @viame_libs@)
set(VIAME_BUILT_SHARED         @BUILD_SHARED_LIBS@)

set(VIAME_VERSION_MAJOR @VIAME_VERSION_MAJOR@)
set(VIAME_VERSION_MINOR @VIAME_VERSION_MINOR@)
set(VIAME_VERSION_PATCH @VIAME_VERSION_PATCH@)
set(VIAME_VERSION       "@VIAME_VERSION@")

set(VIAME_ENABLE_PYTHON "@VIAME_ENABLE_PYTHON@")
set(VIAME_ENABLE_OPENCV "@VIAME_ENABLE_OPENCV@")

if (WIN32)
  add_definitions(-DBOOST_ALL_NO_LIB)
  if(${MSVC_VERSION} GREATER_EQUAL 1915)
    add_definitions(-D_ENABLE_EXTENDED_ALIGNED_STORAGE)
  endif()
endif ()

set(VIAME_INCLUDE_DIR   "@CMAKE_INSTALL_PREFIX@/include")
set(VIAME_INCLUDE_DIRS  "${VIAME_INCLUDE_DIR}")
set(VIAME_LIBRARY_DIR   "@CMAKE_INSTALL_PREFIX@/@KWIVER_DEFAULT_LIBRARY_DIR@@LIB_SUFFIX@")
set(VIAME_LIBRARY_DIRS  "${VIAME_LIBRARY_DIR}")
set(VIAME_MODULE_DIR    "${VIAME_LIBRARY_DIR}/viame/modules")
set(VIAME_PROCESS_DIR   "${VIAME_LIBRARY_DIR}/viame/processes")
set(VIAME_CMAKE_DIR     "${VIAME_LIBRARY_DIR}/cmake/viame")

# The macros a plugin's CMakeLists uses: kwiver_add_plugin,
# algorithms_create_plugin and the rest.
set(KWIVER_CMAKE_DIR    "${VIAME_CMAKE_DIR}")
set(CMAKE_MODULE_PATH   "${VIAME_CMAKE_DIR}" "${VIAME_CMAKE_DIR}/utils" "${CMAKE_MODULE_PATH}")

set(VIAME_DIR "@CMAKE_INSTALL_PREFIX@")
