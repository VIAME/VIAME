# =============================================================================
# Title: Three-Frame Difference Detector
#
# Description: Motion-only detector. Three-frame differencing produces a motion
# heat map, which is thresholded, cleaned with a morphological opening and
# closing, and split into connected components to give boxes. No model is
# loaded and nothing is trained.
#
# Input: IMAGE
# Output: BBOX
# =============================================================================

# ============================= GLOBAL PROPERTIES =============================

config _pipeline:_edge
  :capacity                                    5

config _scheduler
  :type                                        pythread_per_process

# ============================= INPUT FRAME LIST ==============================

include common_default_input_with_downsampler.pipe

# ================================ FORMATTER ==================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

connect from downsampler.output_1
        to   detector_input.image

# ============================== MOTION DETECTION =============================

process motion
  :: detect_motion
  :algo:type                                            ocv_3frame_differencing
  :algo:ocv_3frame_differencing:frame_separation        1
  :algo:ocv_3frame_differencing:jitter_radius           1
  :algo:ocv_3frame_differencing:max_foreground_fract    0.15
  :algo:ocv_3frame_differencing:max_foreground_fract_thresh  10

connect from detector_input.image
        to   motion.image

# =========================== THRESHOLD AND CLEANUP ===========================

process binarize
  :: image_filter
  :filter:type                                 vxl_threshold
  :filter:vxl_threshold:type                   absolute
  :filter:vxl_threshold:threshold              15

connect from motion.motion_heat_map
        to   binarize.image

process opening
  :: image_filter
  :filter:type                                 vxl_morphology
  :filter:vxl_morphology:morphology            open
  :filter:vxl_morphology:element_shape         disk
  :filter:vxl_morphology:kernel_radius         1

connect from binarize.image
        to   opening.image

process closing
  :: image_filter
  :filter:type                                 vxl_morphology
  :filter:vxl_morphology:morphology            close
  :filter:vxl_morphology:element_shape         disk
  :filter:vxl_morphology:kernel_radius         4

connect from opening.image
        to   closing.image

# vxl_threshold and vxl_morphology emit a bool image, which has no OpenCV
# equivalent, so the mask is converted before detect_heat_map reads it.

process mask_to_byte
  :: image_filter
  :filter:type                                 vxl_convert_image
  :filter:vxl_convert_image:format             byte
  :filter:vxl_convert_image:scale_factor       255.0

connect from closing.image
        to   mask_to_byte.image

# ============================ CONNECTED COMPONENTS ===========================

process detector
  :: image_object_detector
  :detector:type                                      detect_heat_map
  :detector:detect_heat_map:threshold                 0
  :detector:detect_heat_map:force_bbox_width          -1
  :detector:detect_heat_map:force_bbox_height         -1
  :detector:detect_heat_map:min_area                  100
  :detector:detect_heat_map:max_area                  400000
  :detector:detect_heat_map:min_fill_fraction         0.05
  :detector:detect_heat_map:class_name                motion

connect from mask_to_byte.image
        to   detector.image

# ================================== OUTPUT ===================================

process detector_writer
  :: detected_object_output

  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv

connect from detector.detected_object_set
        to   detector_writer.detected_object_set
connect from downsampler.output_2
        to   detector_writer.image_file_name

# -- end of file --
