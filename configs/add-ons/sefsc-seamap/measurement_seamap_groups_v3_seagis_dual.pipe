    :output_scale_factor                       1.0
  endblock

connect from detector_merger_r.detected_object_set
        to   detector_fused_r.detected_object_set

connect from downsampler.output_1
        to   detector_rgb_input_r.image
connect from downsampler.output_1
        to   detector_grey_r.image

