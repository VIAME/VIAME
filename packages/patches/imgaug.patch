@@ -353,11 +355,19 @@ def blur_mean_shift_(image, spatial_window_radius, color_window_radius):
     color_window_radius = max(color_window_radius, 0)
 
     image = _normalize_cv2_input_arr_(image)
+    # VIAME: maxLevel=0, explicitly. cv2's default is 1, which combines a
+    # two-level pyramid through a mask whose rule VIAME's kernel does not
+    # reproduce (finding 2.75); maxLevel=0 it reproduces exactly, on a real
+    # frame as well as on random blocks. On a photograph the two differ by
+    # 0.6 of a grey level on average, with a 99.9th percentile of 15 and a
+    # worst case around 50, so this is a real difference and not a rounding
+    # one -- it is stated rather than hidden.
     image = cv2.pyrMeanShiftFiltering(
         image,
         sp=spatial_window_radius,
         sr=color_window_radius,
-        dst=image)
+        dst=image,
+        maxLevel=0)
 
     if shape_is_hw:
         image = image[..., 0]
