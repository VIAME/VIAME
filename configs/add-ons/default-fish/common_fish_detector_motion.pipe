# =============================================================================
# Title: Fish Detector with Motion
#
# Description: RF-DETR fish detector fused with a three-frame-difference branch:
# motion rescores the detector's boxes and adds boxes only where the detector
# found nothing.
# =============================================================================

include common_fish_detector_box.pipe

# ============================== MOTION BRANCH ================================

process motion
  :: detect_motion
  :algo:type                                            ocv_3frame_differencing
  :algo:ocv_3frame_differencing:frame_separation        3
  :algo:ocv_3frame_differencing:jitter_radius           1
  :algo:ocv_3frame_differencing:max_foreground_fract    0.15
  :algo:ocv_3frame_differencing:max_foreground_fract_thresh  10

connect from detector_input.image
        to   motion.image

process motion_binarize
  :: image_filter
  :filter:type                                 vxl_threshold
  :filter:vxl_threshold:type                   absolute
  :filter:vxl_threshold:threshold              15

connect from motion.motion_heat_map
        to   motion_binarize.image

process motion_opening
  :: image_filter
  :filter:type                                 vxl_morphology
  :filter:vxl_morphology:morphology            open
  :filter:vxl_morphology:element_shape         disk
  :filter:vxl_morphology:kernel_radius         1

connect from motion_binarize.image
        to   motion_opening.image

process motion_closing
  :: image_filter
  :filter:type                                 vxl_morphology
  :filter:vxl_morphology:morphology            close
  :filter:vxl_morphology:element_shape         disk
  :filter:vxl_morphology:kernel_radius         4

connect from motion_opening.image
        to   motion_closing.image

# The morphology filters emit a bool image, which has no OpenCV equivalent.

process motion_mask_to_byte
  :: image_filter
  :filter:type                                 vxl_convert_image
  :filter:vxl_convert_image:format             byte
  :filter:vxl_convert_image:scale_factor       255.0

connect from motion_closing.image
        to   motion_mask_to_byte.image

# score_mode is a placeholder; the fusion below rescores every box it keeps.

process motion_detector
  :: image_object_detector
  :detector:type                                      detect_heat_map
  :detector:detect_heat_map:threshold                 0
  :detector:detect_heat_map:force_bbox_width          -1
  :detector:detect_heat_map:force_bbox_height         -1
  :detector:detect_heat_map:min_area                  100
  :detector:detect_heat_map:max_area                  400000
  :detector:detect_heat_map:min_fill_fraction         0.05
  :detector:detect_heat_map:score_mode                0.05
  :detector:detect_heat_map:class_name                fish

connect from motion_mask_to_byte.image
        to   motion_detector.image

# ================================= FUSION ====================================

# detector_output is declared by common_fish_detector_box.pipe; this turns it
# into the fusion and gives it the motion branch as its second input.

config detector_output
  :merger:type                                        coverage_reinforce

  block merger:coverage_reinforce
    :alpha                                            0.30
    :recover_score                                    0.05
    :primary_index                                    1
    :recover                                          true
    :max_evidence_area                                0
  endblock

connect from motion_detector.detected_object_set
        to   detector_output.detected_object_set2
