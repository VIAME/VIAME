# =============================================================================
# Title: Common - Default Fish Box Detector
#
# Description: DEIMv2 trained on FishTrack, run on a 1024x1024 resize of each
# frame. Strongest single fish detector we have measured.
# =============================================================================

process detector_input
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

process detector
  :: image_object_detector
  :detector:type                               onnx

  block detector:onnx
    relativepath model =                       models/fish_deim_v2_1024.zip
    :device                                    cuda
    :score_thresh                              0.10
    :nms_thresh                                0.50
  endblock

connect from detector_input.image
        to   detector.image

process detector_output
  :: merge_detection_sets

connect from detector.detected_object_set
        to   detector_output.detected_object_set1

# -- end of file --
