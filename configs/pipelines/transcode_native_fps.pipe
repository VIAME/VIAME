# =============================================================================
# Title: Transcode video at native FPS with upsampled tracks
#
# Description: Reads a video at native frame rate (no downsampling), resamples
# existing tracks from a downsampled rate to the native rate via bounding box
# interpolation, and outputs both the video and tracks at native FPS.
# =============================================================================

config _pipeline:_edge
  :capacity                                    5

# ============================= INPUT FRAME LIST ==============================

include common_default_input.pipe

# Downsampling off, so every native frame and timestamp passes straight
# through. The downsampler is here for its frame_rate port, which reports the
# source rate once; video_output reads that port a single time, and the input's
# per-frame rate would fill the edge and stall the pipeline.
process downsampler
  :: downsample
  :target_frame_rate                           -1
  :burst_frame_count                           0
  :burst_frame_break                           0
  :renumber_frames                             false

connect from input.image
        to   downsampler.input_1
connect from input.file_name
        to   downsampler.input_2
connect from input.frame_rate
        to   downsampler.frame_rate
connect from input.timestamp
        to   downsampler.timestamp

# ================================= RESAMPLE ==================================

process track_resampler
  :: resample_object_tracks
  :track_file                                  [INSERT_ME]
  :input_rate                                  5            # DIVE_PARAM["Input rate", strictly_positive_int]
  :output_rate                                 1            # DIVE_PARAM["Output rate", strictly_positive_int]
  :reader:type                                 viame_csv

connect from downsampler.timestamp
        to   track_resampler.timestamp

# ================================== OUTPUT ===================================

process filter
  :: image_filter
  :filter:type                                 ocv_enhancer
  :filter:ocv_enhancer:force_8bit              true

connect from downsampler.output_1
        to   filter.image

process video_writer
  :: video_output
  :video_filename                              video_writer.mp4
  :video_writer:type                           ffmpeg

connect from filter.image
        to   video_writer.image
connect from downsampler.timestamp
        to   video_writer.timestamp
connect from downsampler.frame_rate
        to   video_writer.frame_rate

process track_tot_averager
  :: refine_tracks
  :refiner:type                                average_tot
  :refiner:average_tot:tot_option              weighted_average

process track_writer
  :: write_object_track
  :file_name                                   computed_tracks.csv
  :writer:type                                 viame_csv
  :writer:viame_csv:write_time_as_uid          true
  :writer:viame_csv:tot_option                 detection

connect from track_resampler.object_track_set
        to   track_tot_averager.object_track_set
connect from track_tot_averager.object_track_set
        to   track_writer.object_track_set
connect from downsampler.timestamp
        to   track_writer.timestamp
connect from downsampler.output_2
        to   track_writer.image_file_name

# -- end of file --
