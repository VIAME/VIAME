# =============================================================================
# Title: Empty Tracker
#
# Description: Emits an empty track set per frame for pipelines that need a
# track input but have no detector upstream.
#
# Inputs:  downsampler.output_1, downsampler.timestamp
# Outputs: empty_tracker.object_track_set
# =============================================================================

process empty_detector
  :: image_object_detector
  :detector:type                               empty

connect from downsampler.output_1
        to   empty_detector.image

process empty_tracker
  :: initialize_object_tracks
  :track_initializer:type                      threshold

  block track_initializer:threshold:filter
    :type                                      class_probability_filter
    :class_probability_filter:threshold         0.0
    :class_probability_filter:keep_all_classes  true
    :class_probability_filter:keep_classes      unused
  endblock

connect from downsampler.timestamp
        to   empty_tracker.timestamp
connect from empty_detector.detected_object_set
        to   empty_tracker.detected_object_set

# -- end of file --
