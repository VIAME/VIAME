# --- imaging and video -------------------------------------------------------
# `av` and `imageio-ffmpeg` are core, not optional: library/video_io decodes
# and encodes through PyAV, and imageio-ffmpeg carries the ffmpeg binary the
# `ffmpeg_cli` reader falls back to. `opencv-contrib-python-headless` is cv2,
# which came from a source build of OpenCV carried by fletch until phase 1;
# contrib because `ximgproc` and `xfeatures2d` are used.
av
imageio-ffmpeg
opencv-contrib-python-headless
imageio>=2.34.0 ; python_version < "3.12"
imageio>=2.36.0 ; python_version >= "3.12"
scikit-image>=0.22.0,<=0.24.0 ; python_version < "3.12"
scikit-image>=0.24.0 ; python_version >= "3.12"

