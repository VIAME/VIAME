# =============================================================================
# Title: COCO JSON to VIAME CSV Converter
#
# Description: Converts COCO JSON to VIAME CSV, keeping track ids. Frame names
# come from the input image list.
# =============================================================================

config _pipeline:_edge
  :capacity                                                      5

config _scheduler
  :type                                       pythread_per_process

include common_no_load_input_with_downsampler.pipe

# ============================== CONVERTER FUNC ===============================

process detection_reader
  :: read_object_track
  :file_name                                             input.json
  :reader:type                                           coco

process detector_writer
  :: write_object_track
  :file_name                                            output.csv
  :writer:type                                          viame_csv

connect from downsampler.output_2
        to   detection_reader.image_file_name
connect from detection_reader.object_track_set
        to   detector_writer.object_track_set
connect from downsampler.output_2
        to   detector_writer.image_file_name
connect from downsampler.timestamp
        to   detector_writer.timestamp

# -- end of file --
