# Fused equivalent of the GFIT grayscale, window variance, scale and merge stages.
process detector_grey
  :: image_filter
  :filter:type gfit_motion_cuda
  :filter:gfit_motion_cuda:device 0

# Identity preserves the common detector endpoint without another GPU transfer.
process image_merger2
  :: image_filter
  :filter:type vxl_convert_image
  :filter:vxl_convert_image:format disable

connect from detector_grey.image
        to image_merger2.image
