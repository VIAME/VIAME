# =============================================================================
# Title: Process the left image (or full image if non-stitched pair)
#
# Description: Runs object detection pipeline on input imagery. Uses habcam
# input left configuration. Outputs results to computed_detections.csv. Uses
# YOLO-based detection.
# =============================================================================

config _pipeline:_edge
  :capacity                                    10

# ============================= INPUT FRAME LIST ==============================

include common_habcam_input_left.pipe

# ================================= DETECTOR1 =================================

process detector_input_left
  :: image_filter
  :filter:type                                 vxl_convert_image

  block filter:vxl_convert_image
    :format                                    byte
    :force_three_channel                       true
  endblock

connect from left_image_filter.image
        to   detector_input_left.image

process detector_left_2
  :: image_object_detector
  :detector:type                               ocv_windowed

  block detector:ocv_windowed
    :detector:type                             onnx

    # darknet chipped internally at the network size; with a fixed-size ONNX
    # graph that tiling is explicit.
    :mode                                      chip
    :chip_width                                640
    :chip_height                               640
    :chip_step_width                           384
    :chip_step_height                          384
    :chip_edge_filter                          5

    block detector:onnx
      relativepath model =                     models/scallop_yolo_v7_one_class.onnx
      :device                                  cuda
      :score_thresh                            0.010
    endblock
  endblock

connect from detector_input_left.image
        to   detector_left_2.image

# ================================== WRITER ===================================
process detector_writer
  :: detected_object_output

  # Type of file to output
  :file_name                                   computed_detections.csv
  :writer:type                                 viame_csv

connect from detector_left_2.detected_object_set
        to   detector_writer.detected_object_set
connect from downsampler.output_2
        to   detector_writer.image_file_name
connect from downsampler.timestamp
        to   detector_writer.timestamp

# -- end of file --
